diff --git a/openvaf/target/src/spec/wasm32_unknown_emscripten.rs b/openvaf/target/src/spec/wasm32_unknown_emscripten.rs
new file mode 100644
index 0000000..d465983
--- /dev/null
+++ b/openvaf/target/src/spec/wasm32_unknown_emscripten.rs
@@ -0,0 +1,19 @@
+use crate::spec::{LinkerFlavor, Target, TargetOptions};
+
+// Side module de Emscripten (TurboSpice #209): ngspice compilado con MAIN_MODULE lo carga con dlopen.
+// Se enlaza con wasm-ld como lo hace `emcc -sSIDE_MODULE=1` (build_dylib agrega -shared).
+pub fn target() -> Target {
+    let mut base = TargetOptions::default();
+    base.cpu = "generic".to_string();
+    let link_args = base.pre_link_args.entry(LinkerFlavor::Ld).or_default();
+    for arg in "--import-memory --strip-debug --export-dynamic -Bsymbolic --experimental-pic --unresolved-symbols=import-dynamic --stack-first".split(' ') {
+        link_args.push(arg.to_owned())
+    }
+    Target {
+        llvm_target: "wasm32-unknown-emscripten".to_string(),
+        arch: "wasm32".to_string(),
+        data_layout: "e-m:e-p:32:32-p10:8:8-p20:8:8-i64:64-i128:128-f128:64-n32:64-S128-ni:1:10:20".to_string(),
+        options: base,
+        pointer_width: 32,
+    }
+}
