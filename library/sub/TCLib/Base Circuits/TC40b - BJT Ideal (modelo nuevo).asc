TEXT 1648 448 Left 2 !.param vof={Vbe-n*vt0*ln(Iref/hfe/isd)} vor={Vbe-Vsat-ns*vt0*ln(Iref/br/isd)}
TEXT 1648 496 Left 2 !.model DJF D(IS={isd} N={n} TT={tf*hfe})
TEXT 1648 544 Left 2 !.model DJR D(IS={isd} N={ns} TT={tf*br})
