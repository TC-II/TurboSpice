{
  "name": "turbospice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "engine": "bash engine/build.sh",
    "engine:fetch": "node scripts/fetch-engine.mjs",
    "smoke": "node engine/smoke/run.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b",
    "e2e": "node tests/e2e/examples.mjs && node tests/e2e/editor.mjs && node tests/e2e/simulation.mjs && node tests/e2e/features.mjs && node tests/e2e/wires.mjs && node tests/e2e/shortcuts.mjs",
    "assets": "node scripts/copy-engine.mjs && node scripts/build-library.mjs",
    "corpus": "node tests/corpus/roundtrip.mjs && node tests/corpus/explicit.mjs && node tests/corpus/netlist.mjs"
  },
  "dependencies": {
    "blockly": "13.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uplot": "1.6.31"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "playwright-core": "^1.49.1",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
