l_delay=1e-12)\n.model hdl_out bidi_bridge(direction=0 out_low={vol} out_high={voh} drive_low={iol} drive_high={ioh} t_rise={tr} t_fall={tf})\n.model hdl_obuf d_buffer(rise_delay=1e-12 fall_delay=1e-12)\n.model hdl_inverter d_inverter(rise_delay={tpd} fall_delay={tpd})\n.model hdl_and d_and(rise_delay={tpd} fall_delay={tpd})\n.model hdl_nand d_nand(rise_delay={tpd} fall_delay={tpd})\n.model hdl_or d_or(rise_delay={tpd} fall_delay={tpd})\n.model hdl_nor d_nor(rise_delay={tpd} fall_delay={tpd})\n.model hdl_xor d_xor(rise_delay={tpd} fall_delay={tpd})\n.model hdl_xnor d_xnor(rise_delay={tpd} fall_delay={tpd})\n.model hdl_dff0 d_dff(clk_delay={tpd} set_delay={tpd} reset_delay={tpd} ic=0)\n.ends sdadc\n",
