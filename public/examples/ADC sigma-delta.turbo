   "name": "SDADC.v",
   "kind": "verilog",
   "text": "// ADC sigma-delta de primer orden: la parte analógica (integrador RC) está en el esquemático.\n// cmp: la tensión del integrador, que el puente de entrada compara con VIL/VIH (vcc/2).\n// fb:  la realimentación (1 bit) que vuelve al integrador por una resistencia.\n// Cada 64 ciclos de reloj, value = cuántas veces cmp estuvo en 1 (0…64 ≈ Vin/Vcc·64).\nmodule SDADC (\n  input clk,\n  input cmp,\n  output reg fb,\n  output reg [6:0] value\n);\n  reg [5:0] cnt = 0;\n  reg [6:0] acc = 0;\n  initial fb = 0;\n  initial value = 0;\n  always @(posedge clk) begin\n    fb <= ~cmp;\n    cnt <= cnt + 1;\n    if (cnt == 63) begin\n      value <= acc + cmp;\n      acc <= 0;\n    end else\n      acc <= acc + cmp;\n  end\nendmodule\n",
   "synth": {
    "source": "// ADC sigma-delta de primer orden: la parte analógica (integrador RC) está en el esquemático.\n// cmp: la tensión del integrador, que el puente de entrada compara con VIL/VIH (vcc/2).\n// fb:  la realimentación (1 bit) que vuelve al integrador por una resistencia.\n// Cada 64 ciclos de reloj, value = cuántas veces cmp estuvo en 1 (0…64 ≈ Vin/Vcc·64).\nmodule SDADC (\n  input clk,\n  input cmp,\n  output reg fb,\n  output reg [6:0] value\n);\n  reg [5:0] cnt = 0;\n  reg [6:0] acc = 0;\n  initial fb = 0;\n  initial value = 0;\n  always @(posedge clk) begin\n    fb <= ~cmp;\n    cnt <= cnt + 1;\n    if (cnt == 63) begin\n      value <= acc + cmp;\n      acc <= 0;\n    end else\n      acc <= acc + cmp;\n  end\nendmodule\n",
    "module": "sdadc",
