  {
   "name": "SARLOGIC.v",
   "kind": "verilog",
   "text": "// Control logic of the 8-bit SAR ADC (successive approximation register).\n// One conversion takes 10 clock cycles, in three phases that never overlap:\n//   1 sample: smp = 1 closes the top-plate switch (top on vcm) and the input switches (bottom\n//             plates on vin): each capacitor charges to vin − vcm.\n//   1 hold:   every switch opens: the floating top plate keeps that charge, which is the sample.\n//   8 trials: b is the code being tried, bit 7 first. The bits at 1 put their bottom plate on vref\n//             (up) and the ones at 0 on ground (dn); then cmp says whether vin is still above that\n//             trial voltage: if it is the bit stays, if not it goes back to 0, and the next bit is tried.\n// At the end the result goes to data, eoc is 1 for one cycle and the next sample starts.\nmodule SARLOGIC (\n  input clk,\n  input cmp,\n  output reg smp,\n  output reg [7:0] up,\n  output reg [7:0] dn,\n  output reg eoc,\n  output reg [7:0] data\n);\n  reg [7:0] b = 0;      // the successive-approximation register\n  reg [7:0] trial = 0;  // the bit being tried (one-hot)\n  reg hold = 0;\n  initial smp = 1;\n  initial up = 0;\n  initial dn = 0;\n  initial eoc = 0;\n  initial data = 0;\n  wire [7:0] decided = cmp ? b : b & ~trial;\n  wire [7:0] next = decided | (trial >> 1);\n  always @(posedge clk) begin\n    eoc <= 0;\n    if (smp) begin              // sample -> hold\n      smp <= 0;\n      hold <= 1;\n    end else if (hold) begin    // hold -> first trial\n      hold <= 0;\n      b <= 8'b1000_0000;\n      trial <= 8'b1000_0000;\n      up <= 8'b1000_0000;\n      dn <= 8'b0111_1111;\n    end else if (trial[0]) begin  // last trial -> result, and the next sample\n      data <= decided;\n      eoc <= 1;\n      smp <= 1;\n      up <= 0;\n      dn <= 0;\n    end else begin\n      b <= next;\n      trial <= trial >> 1;\n      up <= next;\n      dn <= ~next;\n    end\n  end\nendmodule\n",
   "synth": {
    "source": "// Control logic of the 8-bit SAR ADC (successive approximation register).\n// One conversion takes 10 clock cycles, in three phases that never overlap:\n//   1 sample: smp = 1 closes the top-plate switch (top on vcm) and the input switches (bottom\n//             plates on vin): each capacitor charges to vin − vcm.\n//   1 hold:   every switch opens: the floating top plate keeps that charge, which is the sample.\n//   8 trials: b is the code being tried, bit 7 first. The bits at 1 put their bottom plate on vref\n//             (up) and the ones at 0 on ground (dn); then cmp says whether vin is still above that\n//             trial voltage: if it is the bit stays, if not it goes back to 0, and the next bit is tried.\n// At the end the result goes to data, eoc is 1 for one cycle and the next sample starts.\nmodule SARLOGIC (\n  input clk,\n  input cmp,\n  output reg smp,\n  output reg [7:0] up,\n  output reg [7:0] dn,\n  output reg eoc,\n  output reg [7:0] data\n);\n  reg [7:0] b = 0;      // the successive-approximation register\n  reg [7:0] trial = 0;  // the bit being tried (one-hot)\n  reg hold = 0;\n  initial smp = 1;\n  initial up = 0;\n  initial dn = 0;\n  initial eoc = 0;\n  initial data = 0;\n  wire [7:0] decided = cmp ? b : b & ~trial;\n  wire [7:0] next = decided | (trial >> 1);\n  always @(posedge clk) begin\n    eoc <= 0;\n    if (smp) begin              // sample -> hold\n      smp <= 0;\n      hold <= 1;\n    end else if (hold) begin    // hold -> first trial\n      hold <= 0;\n      b <= 8'b1000_0000;\n      trial <= 8'b1000_0000;\n      up <= 8'b1000_0000;\n      dn <= 8'b0111_1111;\n    end else if (trial[0]) begin  // last trial -> result, and the next sample\n      data <= decided;\n      eoc <= 1;\n      smp <= 1;\n      up <= 0;\n      dn <= 0;\n    end else begin\n      b <= next;\n      trial <= trial >> 1;\n      up <= next;\n      dn <= ~next;\n    end\n  end\nendmodule\n",
    "module": "sarlogic",
