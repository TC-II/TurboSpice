  {
   "name": "DOWNSAMPLER.v",
   "kind": "verilog",
   "text": "// Downsampler (decimation filter) of the sigma-delta ADC: it counts the ones of the 1-bit stream y\n// and, every 64 clock cycles, puts the count on value (0…64 ≈ Vin/Vcc·64): a sinc (moving sum)\n// filter followed by taking one sample out of 64.\nmodule DOWNSAMPLER (\n  input clk,\n  input y,\n  output reg [6:0] value\n);\n  reg [5:0] cnt = 0;\n  reg [6:0] acc = 0;\n  initial value = 0;\n  always @(posedge clk) begin\n    cnt <= cnt + 1;\n    if (cnt == 63) begin\n      value <= acc + y;\n      acc <= 0;\n    end else\n      acc <= acc + y;\n  end\nendmodule\n",
   "synth": {
    "source": "// Downsampler (decimation filter) of the sigma-delta ADC: it counts the ones of the 1-bit stream y\n// and, every 64 clock cycles, puts the count on value (0…64 ≈ Vin/Vcc·64): a sinc (moving sum)\n// filter followed by taking one sample out of 64.\nmodule DOWNSAMPLER (\n  input clk,\n  input y,\n  output reg [6:0] value\n);\n  reg [5:0] cnt = 0;\n  reg [6:0] acc = 0;\n  initial value = 0;\n  always @(posedge clk) begin\n    cnt <= cnt + 1;\n    if (cnt == 63) begin\n      value <= acc + y;\n      acc <= 0;\n    end else\n      acc <= acc + y;\n  end\nendmodule\n",
    "module": "downsampler",
    "subckt": "* Generated by TurboSpice from DOWNSAMPLER.v (Yosys): edit the Verilog, not this file\n.subckt downsampler clk y value_6 value_5 value_4 value_3 value_2 value_1 value_0 vcc=5 vil={vcc/2} vih={vcc/2} vol=0 voh={vcc} iol=20m ioh=20m tr=1n tf=1n tpd=1n\nab_clk [clk] [clk_d] null hdl_in\nab_y [y] [y_d] null hdl_in\nab_value_6 [value_6_d] [value_6] hdl_dac\nab_value_5 [value_5_d] [value_5] hdl_dac\nab_value_4 [value_4_d] [value_4] hdl_dac\nab_value_3 [value_3_d] [value_3] hdl_dac\nab_value_2 [value_2_d] [value_2] hdl_dac\nab_value_1 [value_1_d] [value_1] hdl_dac\nab_value_0 [value_0_d] [value_0] hdl_dac\nag1 cnt_0_d n12 hdl_inverter\nag2 [cnt_0_d cnt_1_d] n14 hdl_and\nag3 [acc_3_d n16] n17 hdl_and\nag4 [acc_4_d n17] n19 hdl_and\nag5 [acc_5_d n19] n21 hdl_and\nag6 [acc_6_d n21] n23 hdl_xnor\nag7 [n24 n23] n25 hdl_or\nag8 [value_6_d n24] n26 hdl_nand\nag9 [n25 n26] n27 hdl_nand\nag10 [cnt_0_d cnt_1_d] n28 hdl_xor\nag11 [cnt_4_d n30] n31 hdl_xor\nag12 [value_0_d n24] n32 hdl_nand\nag13 [cnt_2_d n14] n34 hdl_and\nag14 [y_d acc_0_d] n36 hdl_xor\nag15 [n37 n36] n38 hdl_nand\nag16 [n32 n38] n39 hdl_nand\nag17 [cnt_2_d n14] n40 hdl_xor\nag18 [acc_5_d n19] n41 hdl_xnor\nag19 [n37 n41] n42 hdl_nor\nag20 [acc_4_d n17] n43 hdl_xnor\nag21 [n37 n43] n44 hdl_nor\nag22 [acc_3_d n16] n45 hdl_xnor\nag23 [n37 n45] n46 hdl_nor\nag24 [cnt_3_d n34] n30 hdl_and\nag25 [acc_2_d n49] n50 hdl_xnor\nag26 [n37 n50] n51 hdl_nor\nag27 [acc_1_d n53] n54 hdl_xnor\nag28 [n37 n54] n55 hdl_nor\nag29 [n24 n36] n56 hdl_and\nag30 [n24 n41] n57 hdl_or\nag31 [value_5_d n24] n58 hdl_nand\nag32 [n57 n58] n59 hdl_nand\nag33 [n24 n43] n60 hdl_or\nag34 [value_4_d n24] n61 hdl_nand\nag35 [cnt_4_d n30] n62 hdl_and\nag36 [n60 n61] n63 hdl_nand\nag37 [n24 n45] n64 hdl_or\nag38 [value_3_d n24] n65 hdl_nand\nag39 [n64 n65] n66 hdl_nand\nag40 [n24 n50] n67 hdl_or\nag41 [value_2_d n24] n68 hdl_nand\nag42 [n67 n68] n69 hdl_nand\nag43 [n24 n54] n70 hdl_or\nag44 [value_1_d n24] n71 hdl_nand\nag45 [n70 n71] n72 hdl_nand\nag46 [cnt_5_d n62] n37 hdl_and\nag47 [cnt_3_d n34] n74 hdl_xor\nag48 [cnt_5_d n62] n75 hdl_xor\nag49 [n37 n23] n76 hdl_nor\nag50 [cnt_5_d n62] n24 hdl_nand\nag51 [y_d acc_0_d] n53 hdl_and\nag52 [acc_1_d n53] n49 hdl_and\nag53 [acc_2_d n49] n16 hdl_and\naf54 n39 clk_d null null value_0_d null hdl_dff0\naf55 n72 clk_d null null value_1_d null hdl_dff0\naf56 n69 clk_d null null value_2_d null hdl_dff0\naf57 n66 clk_d null null value_3_d null hdl_dff0\naf58 n63 clk_d null null value_4_d null hdl_dff0\naf59 n59 clk_d null null value_5_d null hdl_dff0\naf60 n27 clk_d null null value_6_d null hdl_dff0\naf61 n56 clk_d null null acc_0_d null hdl_dff0\naf62 n55 clk_d null null acc_1_d null hdl_dff0\naf63 n51 clk_d null null acc_2_d null hdl_dff0\naf64 n46 clk_d null null acc_3_d null hdl_dff0\naf65 n44 clk_d null null acc_4_d null hdl_dff0\naf66 n42 clk_d null null acc_5_d null hdl_dff0\naf67 n76 clk_d null null acc_6_d null hdl_dff0\naf68 n12 clk_d null null cnt_0_d null hdl_dff0\naf69 n28 clk_d null null cnt_1_d null hdl_dff0\naf70 n40 clk_d null null cnt_2_d null hdl_dff0\naf71 n74 clk_d null null cnt_3_d null hdl_dff0\naf72 n31 clk_d null null cnt_4_d null hdl_dff0\naf73 n75 clk_d null null cnt_5_d null hdl_dff0\n.model hdl_in bidi_bridge(direction=1 in_low={vil} in_high={vih} rise_delay=1e-12 fall_delay=1e-12)\n.model hdl_dac dac_bridge(out_low={vol} out_high={voh} out_undef={(vol+voh)/2} t_rise={tr} t_fall={tf})\n.model hdl_inverter d_inverter(rise_delay={tpd} fall_delay={tpd})\n.model hdl_and d_and(rise_delay={tpd} fall_delay={tpd})\n.model hdl_nand d_nand(rise_delay={tpd} fall_delay={tpd})\n.model hdl_or d_or(rise_delay={tpd} fall_delay={tpd})\n.model hdl_nor d_nor(rise_delay={tpd} fall_delay={tpd})\n.model hdl_xor d_xor(rise_delay={tpd} fall_delay={tpd})\n.model hdl_xnor d_xnor(rise_delay={tpd} fall_delay={tpd})\n.model hdl_dff0 d_dff(clk_delay={tpd} set_delay={tpd} reset_delay={tpd} ic=0)\n.ends downsampler\n",
