   "name": "SARLOGIC.asy",
   "kind": "symbol",
   "text": "Version 4\nSymbolType CELL\nRECTANGLE Normal -48 -80 48 80\nWINDOW 0 0 -88 Bottom 2\nWINDOW 3 0 88 Top 2\nSYMATTR SpiceLine vcc=5 vil={vcc/2} vih={vcc/2} vol=0 voh={vcc} iol=20m ioh=20m tr=1n tf=1n tpd=1n\nSYMATTR Prefix X\nSYMATTR Value SARLOGIC\nSYMATTR ModelFile SARLOGIC.sub\nSYMATTR Description Verilog module SARLOGIC\nPIN -48 -64 LEFT 8\nPINATTR PinName clk\nPINATTR SpiceOrder 1\nPIN -48 -32 LEFT 8\nPINATTR PinName cmp\nPINATTR SpiceOrder 2\nPIN 48 -64 RIGHT 8\nPINATTR PinName smp\nPINATTR SpiceOrder 3\nPIN 48 -32 RIGHT 8\nPINATTR PinName up[7:0]\nPINATTR SpiceOrder 4\nPIN 48 0 RIGHT 8\nPINATTR PinName dn[7:0]\nPINATTR SpiceOrder 5\nPIN 48 32 RIGHT 8\nPINATTR PinName eoc\nPINATTR SpiceOrder 6\nPIN 48 64 RIGHT 8\nPINATTR PinName data[7:0]\nPINATTR SpiceOrder 7\n"
  },
  {
   "name": "MODULATOR.v",
   "kind": "verilog",
   "text": "// Digital half of the first-order sigma-delta modulator (the RC integrator is in the schematic):\n// the 1-bit quantizer. On each rising edge of clk it samples cmp, the integrator voltage that the\n// input bridge compares with VIL/VIH (vcc/2):\n//   y:  the 1-bit stream (1 when the integrator was above vcc/2), to the downsampler.\n//   fb: its complement, the feedback that goes back to the integrator through a resistor.\nmodule MODULATOR (\n  input clk,\n  input cmp,\n  output reg y,\n  output reg fb\n);\n  initial y = 0;\n  initial fb = 1;\n  always @(posedge clk) begin\n    y <= cmp;\n    fb <= ~cmp;\n  end\nendmodule\n",
   "synth": {
    "source": "// Digital half of the first-order sigma-delta modulator (the RC integrator is in the schematic):\n// the 1-bit quantizer. On each rising edge of clk it samples cmp, the integrator voltage that the\n// input bridge compares with VIL/VIH (vcc/2):\n//   y:  the 1-bit stream (1 when the integrator was above vcc/2), to the downsampler.\n//   fb: its complement, the feedback that goes back to the integrator through a resistor.\nmodule MODULATOR (\n  input clk,\n  input cmp,\n  output reg y,\n  output reg fb\n);\n  initial y = 0;\n  initial fb = 1;\n  always @(posedge clk) begin\n    y <= cmp;\n    fb <= ~cmp;\n  end\nendmodule\n",
    "module": "modulator",
    "subckt": "* Generated by TurboSpice from MODULATOR.v (Yosys): edit the Verilog, not this file\n.subckt modulator clk cmp y fb vcc=5 vil={vcc/2} vih={vcc/2} vol=0 voh={vcc} iol=20m ioh=20m tr=1n tf=1n tpd=1n\nab_clk [clk] [clk_d] null hdl_in\nab_cmp [cmp] [cmp_d] null hdl_in\nab_y [y_d] [y] hdl_dac\nab_fb [fb_d] [fb] hdl_dac\nag1 cmp_d n6 hdl_inverter\naf2 cmp_d clk_d null null y_d null hdl_dff0\naf3 n6 clk_d null null fb_d null hdl_dff1\n.model hdl_in bidi_bridge(direction=1 in_low={vil} in_high={vih} rise_delay=1e-12 fall_delay=1e-12)\n.model hdl_dac dac_bridge(out_low={vol} out_high={voh} out_undef={(vol+voh)/2} t_rise={tr} t_fall={tf})\n.model hdl_inverter d_inverter(rise_delay={tpd} fall_delay={tpd})\n.model hdl_dff0 d_dff(clk_delay={tpd} set_delay={tpd} reset_delay={tpd} ic=0)\n.model hdl_dff1 d_dff(clk_delay={tpd} set_delay={tpd} reset_delay={tpd} ic=1)\n.ends modulator\n",
    "pins": [
     {
      "name": "clk",
      "dir": "in"
     },
     {
      "name": "cmp",
      "dir": "in"
