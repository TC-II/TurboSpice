  {
   "name": "dsp_impulse.v",
   "kind": "verilog",
   "text": "// Impulso (#366): VALUE durante el primer ciclo de reloj y 0 después (para ver la respuesta\n// de un filtro). Con STEP = 1 es un escalón: VALUE desde el primer flanco y para siempre.\nmodule dsp_impulse #(parameter W = 16, parameter VALUE = 16384, parameter STEP = 0) (\n  input clk,\n  output signed [W-1:0] y\n);\n  reg [1:0] n;\n  initial n = 0;\n  always @(posedge clk) if (n != 2) n <= n + 1;\n  assign y = n == 1 || (STEP != 0 && n == 2) ? VALUE : 0;\nendmodule\n",
   "synth": {
    "source": "// Impulso (#366): VALUE durante el primer ciclo de reloj y 0 después (para ver la respuesta\n// de un filtro). Con STEP = 1 es un escalón: VALUE desde el primer flanco y para siempre.\nmodule dsp_impulse #(parameter W = 16, parameter VALUE = 16384, parameter STEP = 0) (\n  input clk,\n  output signed [W-1:0] y\n);\n  reg [1:0] n;\n  initial n = 0;\n  always @(posedge clk) if (n != 2) n <= n + 1;\n  assign y = n == 1 || (STEP != 0 && n == 2) ? VALUE : 0;\nendmodule\n",
