   "text": "// Multiplicador en punto fijo (#366): y = a·b con F bits fraccionarios (Q1.15: F = 15).\n// RND = 1 redondea al más cercano (si no, trunca); SAT = 1 satura en el desborde.\nmodule dsp_mul #(parameter W = 16, parameter F = 15, parameter RND = 1, parameter SAT = 1) (\n  input signed [W-1:0] a,\n  input signed [W-1:0] b,\n  output signed [W-1:0] y\n);\n  localparam signed [W-1:0] MAX = {1'b0, {(W-1){1'b1}}};\n  localparam signed [W-1:0] MIN = {1'b1, {(W-1){1'b0}}};\n  localparam signed [2*W-1:0] HALF = RND != 0 && F > 0 ? 1 << (F - 1) : 0;\n  wire signed [2*W-1:0] p = a * b;\n  wire signed [2*W-1:0] q = (p + HALF) >>> F;\n  wire ovf = q[2*W-1:W-1] != {(W+1){q[2*W-1]}};\n  assign y = SAT != 0 && ovf ? (q[2*W-1] ? MIN : MAX) : q[W-1:0];\nendmodule\n",
   "synth": {
    "source": "// Multiplicador en punto fijo (#366): y = a·b con F bits fraccionarios (Q1.15: F = 15).\n// RND = 1 redondea al más cercano (si no, trunca); SAT = 1 satura en el desborde.\nmodule dsp_mul #(parameter W = 16, parameter F = 15, parameter RND = 1, parameter SAT = 1) (\n  input signed [W-1:0] a,\n  input signed [W-1:0] b,\n  output signed [W-1:0] y\n);\n  localparam signed [W-1:0] MAX = {1'b0, {(W-1){1'b1}}};\n  localparam signed [W-1:0] MIN = {1'b1, {(W-1){1'b0}}};\n  localparam signed [2*W-1:0] HALF = RND != 0 && F > 0 ? 1 << (F - 1) : 0;\n  wire signed [2*W-1:0] p = a * b;\n  wire signed [2*W-1:0] q = (p + HALF) >>> F;\n  wire ovf = q[2*W-1:W-1] != {(W+1){q[2*W-1]}};\n  assign y = SAT != 0 && ovf ? (q[2*W-1] ? MIN : MAX) : q[W-1:0];\nendmodule\n",
