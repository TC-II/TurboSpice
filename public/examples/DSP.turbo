n.model hdl_in bidi_bridge(direction=1 in_low={vil} in_high={vih} rise_delay=1e-12 fall_delay=1e-12)\n.model hdl_dac dac_bridge(out_low={vol} out_high={voh} out_undef={(vol+voh)/2} t_rise={tr} t_fall={tf})\n.model hdl_inverter d_inverter(rise_delay={tpd} fall_delay={tpd})\n.model hdl_and d_and(rise_delay={tpd} fall_delay={tpd})\n.model hdl_nand d_nand(rise_delay={tpd} fall_delay={tpd})\n.model hdl_or d_or(rise_delay={tpd} fall_delay={tpd})\n.model hdl_nor d_nor(rise_delay={tpd} fall_delay={tpd})\n.model hdl_xor d_xor(rise_delay={tpd} fall_delay={tpd})\n.model hdl_xnor d_xnor(rise_delay={tpd} fall_delay={tpd})\n.ends dsp_sub\n",
