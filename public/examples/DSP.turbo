    "source": "// NCO (#366): seno de amplitud máxima (Q1.15) con un acumulador de fase de 16 bits; en cada flanco\n// la fase avanza FREQ, así que f = FREQ / 65536 · f_reloj. La tabla tiene 256 puntos (los 8 bits de\n// arriba de la fase).\nmodule dsp_nco #(parameter FREQ = 1024) (\n  input clk,\n  output reg signed [15:0] y\n);\n  reg [15:0] phase;\n  reg signed [15:0] s;\n  initial phase = 0;\n  initial y = 0;\n  always @(posedge clk) begin\n    phase <= phase + FREQ;\n    y <= s;\n  end\n  always @* begin\n    case (phase[15:8])\n      8'd0: s = 0;\n      8'd1: s = 804;\n      8'd2: s = 1608;\n      8'd3: s = 2410;\n      8'd4: s = 3212;\n      8'd5: s = 4011;\n      8'd6: s = 4808;\n      8'd7: s = 5602;\n      8'd8: s = 6393;\n      8'd9: s = 7179;\n      8'd10: s = 7962;\n      8'd11: s = 8739;\n      8'd12: s = 9512;\n      8'd13: s = 10278;\n      8'd14: s = 11039;\n      8'd15: s = 11793;\n      8'd16: s = 12539;\n      8'd17: s = 13279;\n      8'd18: s = 14010;\n      8'd19: s = 14732;\n      8'd20: s = 15446;\n      8'd21: s = 16151;\n      8'd22: s = 16846;\n      8'd23: s = 17530;\n      8'd24: s = 18204;\n      8'd25: s = 18868;\n      8'd26: s = 19519;\n      8'd27: s = 20159;\n      8'd28: s = 20787;\n      8'd29: s = 21403;\n      8'd30: s = 22005;\n      8'd31: s = 22594;\n      8'd32: s = 23170;\n      8'd33: s = 23731;\n      8'd34: s = 24279;\n      8'd35: s = 24811;\n      8'd36: s = 25329;\n      8'd37: s = 25832;\n      8'd38: s = 26319;\n      8'd39: s = 26790;\n      8'd40: s = 27245;\n      8'd41: s = 27683;\n      8'd42: s = 28105;\n      8'd43: s = 28510;\n      8'd44: s = 28898;\n      8'd45: s = 29268;\n      8'd46: s = 29621;\n      8'd47: s = 29956;\n      8'd48: s = 30273;\n      8'd49: s = 30571;\n      8'd50: s = 30852;\n      8'd51: s = 31113;\n      8'd52: s = 31356;\n      8'd53: s = 31580;\n      8'd54: s = 31785;\n      8'd55: s = 31971;\n      8'd56: s = 32137;\n      8'd57: s = 32285;\n      8'd58: s = 32412;\n      8'd59: