  {
   "name": "dsp_shift.asy",
   "kind": "symbol",
   "text": "Version 4\nSymbolType CELL\nLINE Normal -32 -32 -32 32\nLINE Normal -32 32 32 0\nLINE Normal 32 0 -32 -32\nLINE Normal -64 0 -32 0\nLINE Normal 32 0 64 0\nTEXT -12 0 Center 1 2ᴷ\nWINDOW 0 0 -40 Bottom 2\nWINDOW 3 0 0 Invisible 2\nSYMATTR SpiceLine vcc=5 vil={vcc/2} vih={vcc/2} vol=0 voh={vcc} iol=20m ioh=20m tr=1n tf=1n tpd=1n K=1 SAT=1 W=16 hdl=auto\nSYMATTR Prefix X\nSYMATTR Value dsp_shift\nSYMATTR ModelFile dsp_shift.sub\nSYMATTR Description Verilog module dsp_shift\nPIN -64 0 NONE 0\nPINATTR PinName x[15:0]\nPINATTR SpiceOrder 1\nPIN 64 0 NONE 0\nPINATTR PinName y[15:0]\nPINATTR SpiceOrder 2\n"
  },
  {
   "name": "dsp_shift.v",
   "kind": "verilog",
   "text": "// Ganancia ×2^K (#366): K > 0 desplaza a la izquierda (satura si SAT = 1), K < 0 a la derecha\n// con signo (trunca hacia −∞).\nmodule dsp_shift #(parameter W = 16, parameter K = 1, parameter SAT = 1) (\n  input signed [W-1:0] x,\n  output signed [W-1:0] y\n);\n  localparam signed [W-1:0] MAX = {1'b0, {(W-1){1'b1}}};\n  localparam signed [W-1:0] MIN = {1'b1, {(W-1){1'b0}}};\n  generate\n    if (K >= 0) begin : left\n      wire signed [W+K-1:0] s = x <<< K;\n      wire ovf = s[W+K-1:W-1] != {(K+1){s[W+K-1]}};\n      assign y = SAT != 0 && ovf ? (s[W+K-1] ? MIN : MAX) : s[W-1:0];\n    end else begin : right\n      assign y = x >>> (-K);\n    end\n  endgenerate\nendmodule\n",
   "synth": {
