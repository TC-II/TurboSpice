   "text": "Version 4\nSymbolType CELL\nRECTANGLE Normal -32 -24 32 24\nLINE Normal 32 0 64 0\nLINE Normal -20 8 -10 8\nLINE Normal -10 8 -10 -8\nLINE Normal -10 -8 0 -8\nLINE Normal 0 -8 0 8\nLINE Normal 0 8 10 8\nLINE Normal 10 8 10 -8\nLINE Normal 10 -8 20 -8\nWINDOW 0 0 -32 Bottom 2\nWINDOW 3 0 0 Invisible 2\nSYMATTR SpiceLine vcc=5 vil={vcc/2} vih={vcc/2} vol=0 voh={vcc} iol=20m ioh=20m tr=1n tf=1n tpd=1n PERIOD=1000 hdl=auto\nSYMATTR Prefix X\nSYMATTR Value dsp_clock\nSYMATTR ModelFile dsp_clock.sub\nSYMATTR Description Verilog module dsp_clock\nPIN 64 0 NONE 0\nPINATTR PinName clk\nPINATTR SpiceOrder 1\n"
  },
  {
   "name": "dsp_clock.v",
   "kind": "verilog",
   "text": "// Reloj (#366): una onda cuadrada de PERIOD ns (1000: 1 MHz) que arranca en 0. Es de comportamiento\n// (un retardo #): corre adentro del módulo único de Icarus, así el reloj no pasa por lo analógico\n// (ni una fuente de pulsos ni sus puentes). No se puede sintetizar: con hdl=gates, una fuente PULSE.\n`timescale 1ns/1ps\nmodule dsp_clock #(parameter PERIOD = 1000) (\n  output reg clk\n);\n  initial clk = 0;\n  always #(PERIOD / 2.0) clk = ~clk;\nendmodule\n",
   "hdl": "behavioral",
   "synth": {
    "source": "// Reloj (#366): una onda cuadrada de PERIOD ns (1000: 1 MHz) que arranca en 0. Es de comportamiento\n// (un retardo #): corre adentro del módulo único de Icarus, así el reloj no pasa por lo analógico\n// (ni una fuente de pulsos ni sus puentes). No se puede sintetizar: con hdl=gates, una fuente PULSE.\n`timescale 1ns/1ps\nmodule dsp_clock #(parameter PERIOD = 1000) (\n  output reg clk\n);\n  initial clk = 0;\n  always #(PERIOD / 2.0) clk = ~clk;\nendmodule\n",
    "module": "dsp_clock",
    "subckt": "* Generated by TurboSpice from dsp_clock.v (Icarus Verilog): edit the Verilog, not this file\n.subckt dsp_clock clk vcc=5 vil={vcc/2} vih={vcc/2} vol=0 voh={vcc} iol=20m ioh=20m tr=1n tf=1n tpd=1n period=1000\nab_clk [clk_d] [clk] hdl_dac\nacosim null [clk_d] null hdl_cosim\n.model hdl_in bidi_bridge(direction=1 in_low={vil} in_high={vih} rise_delay=1e-12 fall_delay=1e-12)\n.model hdl_dac dac_bridge(out_low={vol} out_high={voh} out_undef={(vol+voh)/2} t_rise={tr} t_fall={tf})\n.model hdl_cosim d_cosim(simulation=\"/usr/local/lib/ngspice/ivlng.so\" sim_args=[\"dsp_clock.vvp\"] lib_args=[\"/usr/local/lib/ngspice/libvvp.so\" \"/usr/local/lib/ngspice/ivlng\"] delay={tpd})\n.ends dsp_clock\n",
    "pins": [
     {
      "name": "clk",
      "dir": "out"
     }
    ],
    "params": {
     "PERIOD": "1000"
    },
    "vvp": "#! vvp\n:ivl_version \"14.0 (devel)\" \"(9cfecc9)\";\n:ivl_delay_selection \"TYPICAL\";\n:vpi_time_precision - 12;\n:vpi_module \"/usr/local/lib/ngspice/system.vpi\";\n:vpi_module \"/usr/local/lib/ngspice/v2005_math.vpi\";\n:vpi_module \"/usr/local/lib/ngspice/va_math.vpi\";\nS_0x4e9d80 .scope module, \"dsp_clock\" \"dsp_clock\" 2 5;\n .timescale -9 -12;\n    .port_info 0 /OUTPUT 1 \"clk\";\nP_0x4e9e48 .param/l \"PERIOD\" 0 2 5, +C4<00000000000000000000001111101000>;\nv0x4e9f48_0 .var \"clk\", 0 0;\n    .scope S_0x4e9d80;\nT_0 ;\n    %pushi/vec4 0, 0, 1;\n    %store/vec4 v0x4e9f48_0, 0, 1;\n    %end;\n    .thread T_0;\n    .scope S_0x4e9d80;\nT_1 ;\n    %delay 500000, 0;\n    %load/vec4 v0x4e9f48_0;\n    %inv;\n    %store/vec4 v0x4e9f48_0, 0, 1;\n    %jmp T_1;\n    .thread T_1;\n# The file index is used to find the file name in the following table.\n:file_names 3;\n    \"N/A\";\n    \"<interactive>\";\n    \"/src/dsp_clock.v\";\n"
   }
