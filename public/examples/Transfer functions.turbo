 "files": [
  {
   "name": "OA_NoPole.asy",
   "kind": "symbol",
   "text": "Version 4\nSymbolType CELL\nLINE Normal -192 -8 -80 48\nLINE Normal -192 -8 -192 104\nLINE Normal -181 16 -173 16\nLINE Normal -180 80 -172 80\nLINE Normal -176 84 -176 76\nLINE Normal -80 48 -192 104\nWINDOW 0 -113 80 Left 2\nWINDOW 3 -176 32 Left 0\nSYMATTR Value Avol=1Meg\nSYMATTR SpiceModel OA_NoPole\nSYMATTR ModelFile OA_NoPole.sub\nSYMATTR Prefix X\nSYMATTR Description Op amp without poles: only a gain Avol (TCLib OA_Ideal drawing; a project file)\nPIN -192 80 NONE 0\nPINATTR PinName In+\nPINATTR SpiceOrder 1\nPIN -192 16 NONE 0\nPINATTR PinName In-\nPINATTR SpiceOrder 2\nPIN -80 48 NONE 0\nPINATTR PinName OUT\nPINATTR SpiceOrder 3\n"
  },
  {
   "name": "OA_NoPole.sub",
   "kind": "model",
   "text": "* OA_NoPole: an op amp without poles, only its open-loop gain Avol (the drawing is TCLib's\n* OA_Ideal, by Javier Petrucci and Agustin Gullino, ITBA). OA_Ideal has one pole (GBWP), and in\n* a pole-zero map that pole shows up far away, at about −2π·GBWP/2, and squeezes the others.\n.SUBCKT OA_NoPole 1 2 3\nE1 3 0 1 2 {Avol}\n.ends OA_NoPole\n"
  }
 ],
