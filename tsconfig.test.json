{
  // Chequeo de tipos de los tests unitarios y los scripts en TypeScript (tsconfig.json sólo cubre src/)
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests/unit", "tests/setup-i18n.ts", "tests/**/*.d.mts", "scripts/**/*.ts", "scripts/**/*.d.mts"]
}
